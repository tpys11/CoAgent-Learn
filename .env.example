# 本文件为开发/运行环境配置（实际值）。密钥类变量请勿提交到 git。
# 字段全量对齐 backend/core/config.py；注释中标注了默认值与可选值。

# ── 主模型（对话/生成，OpenAI 兼容协议）──
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 智谱 GLM-4V（图片描述入库，多模态；不配则图片上传会提示未配置）
ZHIPU_API_KEY=

# ── 并发与超时 ──
LLM_MAX_CONCURRENCY=3
LLM_REQUEST_TIMEOUT=120

# ── 数据目录（SQLite app.db 所在目录）──
SQLITE_DIR=./data

# ── embedding 后端（local=本地部署模型，api=OpenAI 兼容服务，如硅基流动）──
# 切换注意：API embedding 维度（如 bge-m3=1024）与本地 bge-small-zh=512 不同，
# 切换后需清空知识库重新入库（向量表维度固定）。
EMBEDDING_BACKEND=local                # local | api
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1   # bge-m3 统一接口
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512                      # bge-m3=1024，本地 bge-small-zh=512

# ── rerank 后端（local | api | none，none=禁用重排）──
RERANK_BACKEND=local                   # local | api | none
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_KEY=
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_LOCAL_MODEL=BAAI/bge-reranker-base

# ── 图片处理/视觉（多模态）：none | api（通用 OpenAI 兼容视觉接口）──
IMAGE_BACKEND=none
# IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# IMAGE_API_KEY=
# IMAGE_MODEL=glm-4v-flash

# ── Qwen3-VL-Embedding（视觉/跨模态向量通道；文本向量化优先 BGE，此 key 供视觉通道）──
# VL_API_KEY=
# VL_MODEL=Qwen/Qwen3-VL-Embedding-8B
# VL_BASE_URL=https://api.siliconflow.cn/v1
# VL_EMBEDDING_DIM=4096

# 图片描述（多模态对话）：走硅基流动视觉模型（复用硅基流动 key），模型可换
# IMAGE_DESC_MODEL=Qwen/Qwen3.5-4B

# ── 知识库服务档位：light=仅文字向量化+重排；full=再加图片向量化/跨模态检索 ──
KB_MODE=full

# ── 独立审核模型（走硅基流动）：0=关闭（审核回退主模型同系快模型 deepseek v4 flash）；1=开启 ──
REVIEW_ENABLED=0
# REVIEW_MODEL=Qwen/Qwen2.5-72B-Instruct
# 双 LLM 审核：思考档用主模型同系快模型（走用户 key），研究档用独立审核模型（走硅基流动 key）
# REVIEW_MODEL_THINK=deepseek-v4-flash
# REVIEW_MODEL_RESEARCH=Qwen/Qwen2.5-72B-Instruct

# ── 联网代理（可选）：容器访问国外站点（GitHub 等）失败时，配宿主梯子代理 ──
# 例：PROXY_URL=http://host.docker.internal:7993（宿主梯子监听端口）
# PROXY_URL=