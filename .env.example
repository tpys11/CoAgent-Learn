# DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── embedding / rerank 后端（默认 local=本地模型；改 api 并填 key 即可无缝切换）──
# 切换注意：API embedding 维度（如 bge-m3=1024）与本地 bge-small-zh=512 不同，
# 切换后需清空知识库重新入库（向量表维度固定）。
# EMBEDDING_BACKEND=local        # local | api
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-your-key
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024
# RERANK_BACKEND=local           # local | api | none（none=禁用重排）
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_KEY=sk-your-key
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# PROXY_URL=http://host.docker.internal:7993
