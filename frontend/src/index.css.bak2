@tailwind base;
@tailwind components;
@tailwind utilities;

* { margin: 0; padding: 0; box-sizing: border-box; }
html, body, #root { width: 100vw; height: 100vh; overflow: hidden; }
body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 15px; }

/* ============ 主题系统（日间/夜间/均衡，跟随系统由 JS 解析为 light/dark） ============ */

/* 日间：白色为主、黑色为辅 */
:root, [data-theme="light"] {
  --bg-root: #ffffff;
  --bg-sidebar: #f5f5f5;
  --bg-panel: #ffffff;
  --bg-hover: #ededed;
  --bg-active: #f0f0f0;
  --border-color: #e5e5e5;
  --border-strong: #d0d0d0;
  --bg-input: #fafafa;
  --bg-modal: #ffffff;
  --accent: #1a1a1a;
  --accent-hover: #333333;
  --text-muted: #888888;
}

/* 夜间：黑色为主、深蓝色为辅 */
[data-theme="dark"] {
  --bg-root: #0f1218;
  --bg-sidebar: #151a23;
  --bg-panel: #1a2030;
  --bg-hover: #232b3d;
  --bg-active: #2a3450;
  --border-color: #2b3550;
  --border-strong: #3a4666;
  --bg-input: #161c29;
  --bg-modal: #1a2030;
  --accent: #4f8cff;
  --accent-hover: #3b74d9;
  --text-muted: #8a94ab;
}

/* 均衡：浅黄色族系为主，减少纯白强刺激 */
[data-theme="warm"] {
  --bg-root: #f6f1e6;
  --bg-sidebar: #efe8d8;
  --bg-panel: #fbf8f0;
  --bg-hover: #e9e0cd;
  --bg-active: #f5ecd9;
  --border-color: #ddd3bd;
  --border-strong: #c9bda2;
  --bg-input: #faf5ea;
  --bg-modal: #fbf8f0;
  --accent: #c75f1a;
  --accent-hover: #a84a10;
  --text-muted: #8a8272;
}

/* ============ 主题覆盖（对组件内硬编码 Tailwind 类做主题适配） ============ */

/* 夜间：黑底深蓝 */
[data-theme=dark] body,[data-theme=dark] #root{color:#dbe2f0;background:#0f1218}
[data-theme=dark] .bg-\[\#1a1a1a\]{background-color:#4f8cff!important}
[data-theme=dark] .bg-\[\#333333\]{background-color:#3b74d9!important}
[data-theme=dark] .bg-\[\#f5f5f5\]{background-color:#151a23!important}
[data-theme=dark] .bg-\[\#f0f0f0\]{background-color:#2a3450!important}
[data-theme=dark] .bg-\[\#ffffff\]{background-color:#1a2030!important}
[data-theme=dark] .bg-\[\#fafafa\]{background-color:#161c29!important}
[data-theme=dark] .bg-\[\#ededed\]{background-color:#232b3d!important}
[data-theme=dark] .hover\:bg-\[\#ededed\]:hover{background-color:#232b3d!important}
[data-theme=dark] .hover\:bg-\[\#333333\]:hover{background-color:#3b74d9!important}
[data-theme=dark] .border-\[\#e5e5e5\]{border-color:#2b3550!important}
[data-theme=dark] .border-\[\#d0d0d0\]{border-color:#3a4666!important}
[data-theme=dark] .text-\[\#1a1a1a\]{color:#dbe2f0!important}
[data-theme=dark] input,[data-theme=dark] textarea{background-color:#161c29!important;color:#dbe2f0!important}

/* 均衡：浅黄去纯白 */
[data-theme=warm] .bg-\[\#1a1a1a\]{background-color:#c75f1a!important}
[data-theme=warm] .bg-\[\#333333\]{background-color:#a84a10!important}
[data-theme=warm] .bg-\[\#f5f5f5\]{background-color:#efe8d8!important}
[data-theme=warm] .bg-\[\#f0f0f0\]{background-color:#f5ecd9!important}
[data-theme=warm] .bg-\[\#ffffff\]{background-color:#fbf8f0!important}
[data-theme=warm] .bg-\[\#fafafa\]{background-color:#faf5ea!important}
[data-theme=warm] .bg-\[\#ededed\]{background-color:#e9e0cd!important}
[data-theme=warm] .hover\:bg-\[\#ededed\]:hover{background-color:#e9e0cd!important}
[data-theme=warm] .border-\[\#e5e5e5\]{border-color:#ddd3bd!important}
[data-theme=warm] .border-\[\#d0d0d0\]{border-color:#c9bda2!important}
[data-theme=warm] .text-\[\#1a1a1a\]{color:#c75f1a!important}
[data-theme=warm] .hover\:bg-\[\#333333\]:hover{background-color:#a84a10!important}
[data-theme=warm] input,[data-theme=warm] textarea{background-color:#faf5ea!important}
